uint16_t present_brightness = 0;
void set_backlight_bright(uint16_t value)
{
    if (present_brightness == value) return;
    ledcFade(TFT_BL, present_brightness, value, 500);
    present_brightness = value;
}

static void update_mac_label(void)
{
    char showMac[32] = "";

    if (wifiParam.wireless == WIRELESS_BLE)
    {
        uint8_t m[6];
        alite2_ble_mac(m);
        snprintf(showMac, sizeof(showMac), "BLE:%02X%02X%02X%02X%02X%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
    }
    else if ((wifiParam.wireless == WIRELESS_ARTNET) || (wifiParam.wireless == WIRELESS_sACN))
    {
        char mac[13];
        alite2_wifi_mac(mac);
        snprintf(showMac, sizeof(showMac), "WIFI:%s", mac);
    }
    else if (wifiParam.wireless == WIRELESS_LUMEN)
    {
        strncpy(showMac, "LUMEN", sizeof(showMac));
        showMac[sizeof(showMac) - 1] = '\0';
    }

    custom_label_set_text(ui_MacLabel, showMac);
}

