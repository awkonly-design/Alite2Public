void set_return_to_local(void)
{
    return_to_local = millis();
}

bool get_return_to_local(void)
{
    return ((millis() - return_to_local) > 10000);
}


void print_wakeup_reason(void) 
{
    esp_sleep_wakeup_cause_t wakeup_reason;
    bool skip_check_wakeup_key = false;

    bootCount++;
    wakeup_reason = esp_sleep_get_wakeup_cause();

    switch(wakeup_reason) 
    {
        case ESP_SLEEP_WAKEUP_EXT0:     dbg.println("Wakeup caused by external signal using RTC_IO"); break;
        case ESP_SLEEP_WAKEUP_EXT1:     dbg.println("Wakeup caused by external signal using RTC_CNTL"); break;
        case ESP_SLEEP_WAKEUP_TIMER:    dbg.println("Wakeup caused by timer"); break;
        case ESP_SLEEP_WAKEUP_TOUCHPAD: dbg.println("Wakeup caused by touchpad"); break;
        case ESP_SLEEP_WAKEUP_ULP:      dbg.println("Wakeup caused by ULP program"); break;
        default:                        
            dbg.printf("Wakeup was not caused by deep sleep: %d\n", wakeup_reason);
            skip_check_wakeup_key = true;
        break;
    }

    if (skip_check_wakeup_key)
        return;
/* here
    pinMode(WAKEUP_GPIO, INPUT_PULLUP);
        
    for(int i = 0; i < 10; i++)
    {
        delay(100);
        if (digitalRead(WAKEUP_GPIO) != 0)
            sleep_with_wakeup_pin();
    }
*/
}

void print_reset_reason(void)
{
    esp_reset_reason_t reason = esp_reset_reason();
    dbg.print("🔍 Reset Reason: ");
    switch (reason) 
    {
        case ESP_RST_POWERON:    dbg.println("Power-on reset"); break;
        case ESP_RST_EXT:        dbg.println("External reset"); break;
        case ESP_RST_SW:         dbg.println("Software reset"); break;
        case ESP_RST_PANIC:      dbg.println("Exception/panic"); break;
        case ESP_RST_INT_WDT:    dbg.println("Interrupt watchdog"); break;
        case ESP_RST_TASK_WDT:   dbg.println("Task watchdog"); break;
        case ESP_RST_WDT:        dbg.println("Other watchdog reset"); break;
        case ESP_RST_DEEPSLEEP:  dbg.println("Wake from deep sleep"); break;
        case ESP_RST_BROWNOUT:   dbg.println("Brownout reset"); break;
        case ESP_RST_SDIO:       dbg.println("Reset by SDIO"); break;
        default:                 dbg.println("Unknown reason"); break;
    }
}

void heap_caps_alloc_failed_hook(size_t requested_size, uint32_t caps, const char *function_name)
{
    dbg.printf("%s was called but failed to allocate %d bytes with 0x%X capabilities. \n", function_name, requested_size, caps);
}

void init_wireless(void)
{
    if (wifiParam.wireless == WIRELESS_BLE)
    {
        lv_img_set_src(ui_RadioImage, &ui_img_wifi0_png);
        alite2_ble_begin();
    }
    else if (wifiParam.wireless == WIRELESS_ARTNET)
    {
        alite2_wifi_begin(DEFAULT_WIFI_SSID, DEFAULT_WIFI_PASS);
        init_artnet();
        alite2_ota_begin(OTA_HOSTNAME, NULL, OTA_PORT, FIRMWARE_VERSION);
        web_fs_setup();
    }
    else if (wifiParam.wireless == WIRELESS_LUMEN)
    {
        lv_img_set_src(ui_RadioImage, &ui_img_wifi4_png);
        init_lumen();
    }
    else if (wifiParam.wireless == WIRELESS_BROADCASTER)
    {
        lv_img_set_src(ui_RadioImage, &ui_img_wifi0_png);
        init_wireless_broadcaster();
    }
    else if (wifiParam.wireless == WIRELESS_AUDIENCE)
    {
        lv_img_set_src(ui_RadioImage, &ui_img_wifi0_png);
        init_wireless_audience();
    }
    else if (wifiParam.wireless == WIRELESS_sACN)
    {
        alite2_wifi_begin(DEFAULT_WIFI_SSID, DEFAULT_WIFI_PASS);
        alite2_ota_begin(OTA_HOSTNAME, NULL, OTA_PORT, FIRMWARE_VERSION);
        web_fs_setup();
    }
}

void setup()
{
    //rtc_gpio_hold_dis(GPIO_NUM_12);
    //rtc_gpio_hold_dis(GPIO_NUM_15);
    //delay(1000);
    //pinMode(WAKEUP_GPIO, INPUT_PULLUP);
    pinMode(BAT_EN, OUTPUT);
    digitalWrite(BAT_EN, LOW);//hold battery power

    esp_err_t error = heap_caps_register_failed_alloc_callback(heap_caps_alloc_failed_hook);

#ifdef USE_USB_DEBUG
    USB.begin();//making USB CDC
#endif
    dbg.begin(115200);
    init_led();//have to turn led off as faster as 

    //while(!dbg) delay(100);//special case: holding here before connected by PC minicom
    delay(100);
    dbg.print("Alite2 v");
    dbg.println(FIRMWARE_VERSION);
    
    pinMode(DCDC_EN_PIN, OUTPUT);
    digitalWrite(DCDC_EN_PIN, LOW);
   
#ifdef TFT_BL
    pinMode(TFT_BL, OUTPUT);
    //digitalWrite(TFT_BL, HIGH);
#endif
    ledcAttach(TFT_BL, LCD_PWM_HZ, LCD_PWM_BITS);

    load_wifi_parameters();

    print_wakeup_reason();
    print_reset_reason();

    parametersInit();
    init_fs();
    if (lcd_init())
    {
        //lv_demo_benchmark();
        ui_init();
        multi_language_apply_strings(wifiParam.lang);
        //dbg.println("Setup done");
    }

    ui_initSlot();
    ui_initScreen();
    ui_initGlobalScreen();

    lv_obj_set_parent(ui_BarBattery, lv_layer_top());
    lv_obj_set_parent(ui_BatteryHead, lv_layer_top());
    lv_obj_set_parent(ui_TempLabel, lv_layer_top());
    lv_obj_set_parent(ui_BoltImage, lv_layer_top());
    lv_obj_set_parent(ui_RadioImage, lv_layer_top());
    lv_obj_set_parent(ui_BoostImage, lv_layer_top());

    if (readPDVolt() > USB_CONNECTED_VOLT)//Something connected USB-C
    {
        charging_message = true;
        wifiParam.wireless = WIRELESS_OFF;//do not initial init_wireless()
        digitalWrite(BAT_EN, HIGH);
        show_message_box("Charger", "USB connected\n\nPress and hold F1\nto turn on");
    }
    else
    {
        digitalWrite(DCDC_EN_PIN, HIGH);
        switchScreen(wifiParam.lastPage, LV_SCR_LOAD_ANIM_NONE);
    }

    init_buttons();
    init_wireless();
    init_battery();
    init_adc();

    lv_timer_handler();//update screen
    set_backlight_bright(LCD_PWM_VALUE);//Once run in initial
    //here while(digitalRead(WAKEUP_GPIO) == LOW);

    updateLocalLED();
    last_ms = millis();
    set_return_to_local();

    set_kelvin_table();

    update_mac_label();
    official_update_result();   // after Setup > H/W > Upgrade F/W came back into this firmware

    // initialise the watchdog last
    esp_task_wdt_init(&wdt_config);
    esp_task_wdt_add(NULL);  // register the current task (loop) with the WDT
}

void process_wireless_signal(void)
{
    switch(set_artnet_pwm_update())
    {
        case 0://single
            set_avg_count(3);
            set_led_pwm(); 
        break;
        case 1://pixels
            set_avg_count(3);
        break;
    }
}

void loop()
{
    uint8_t key;

    lv_timer_handler();//update screen

    if (wifiParam.wireless == WIRELESS_BLE)
        alite2_ble_loop();
    else if (wifiParam.wireless == WIRELESS_ARTNET)
    {
        alite2_wifi_loop();
        artnet_loop();
        web_fs_loop();
    }
    else if (wifiParam.wireless == WIRELESS_LUMEN)
    {
        lumen_process();
    }
    else if (wifiParam.wireless == WIRELESS_BROADCASTER)
    {
        wireless_broadcaster_loop();
    }
    else if (wifiParam.wireless == WIRELESS_AUDIENCE)
    {
        wireless_audience_loop();
    }
    else if (wifiParam.wireless == WIRELESS_sACN)
    {
        alite2_wifi_loop();
        web_fs_loop();
    }

    {
        key = loop_buttons();
        if (key != NULL_KEY)
        {
            set_backlight_bright(LCD_PWM_VALUE);
            last_ms = millis();

            switch(key)
            {
                case F1_KEY_LONG:
                    if (charging_message)//when it's turning on
                    {
                        charging_message = false;
                        wifiParam.wireless = wififs.getUChar(WIRELESS_KEY, WIRELESS_ARTNET);
                        init_wireless();
                        update_mac_label();

                        digitalWrite(BAT_EN, LOW);//hold battery power
                        digitalWrite(DCDC_EN_PIN, HIGH);
                        turnOnScreenOnce(LV_SCR_LOAD_ANIM_FADE_ON);
                    }
                    else
                        power_down();
                break;
            }

            lv_obj_t *screen = lv_scr_act();
            if (screen != NULL)
            {
                if (screen == ui_MainScreen) ui_MainScreenState(screen, &key);
                else if (screen == ui_ScreenDimming) ui_ScreenDimmingState(screen, &key);
                else if (screen == ui_ScreenWavelength) ui_ScreenWavelengthState(screen, &key);
                else if (screen == ui_ScreenEffect) ui_ScreenEffectState(screen, &key);
                else if (screen == ui_ArtnetScreen) ui_ArtnetScreenState(screen, &key);
                else if (screen == ui_SetupScreen) ui_SetupScreenState(screen, &key);
                else if (screen == ui_MessageScreen) ui_MessageScreenState(screen, &key);
                else if (screen == ui_QrScreen) ui_QrScreenState(screen, &key);
                else if (screen == ui_MenuScreen) ui_MenuScreenState(screen, &key);
            }
        }

        switch(display_led)
        {
            case DISPLAY_LED_LOCAL:
                set_return_to_local();//to prevent reset

                if (param.effect.trig != TRIG_ON)
                {
                    updateLocalLED();
                    set_avg_count(AVG_SHIFT);
                    set_led_pwm();//for making smooth
                    //dbg.printf("x");
                }
            break;
            case DISPLAY_LED_BLE:
                process_wireless_signal();
            break;
            case DISPLAY_LED_ARTNET:
                if (art_update)//It's always true when if there is no artsync packet
                {
                    art_update = false;
                    process_wireless_signal();
                }
                //dbg.println("DISPLAY_LED_ARTNET");
            break;
            case DISPLAY_LED_DMX512:
                process_wireless_signal();
            break;
        }

        if (param.effect.trig == TRIG_ON)
        {
            if (param.effect.no == EFFECT_FIRE)
            {
                set_avg_count(3);
                updateFireEffect();
            }
            else if (param.effect.no == EFFECT_FIREWORK)
            {
                set_avg_count(0);
                updateFireworkEffect();
            }
            else if (param.effect.no == EFFECT_ACCIDENT)
            {
                set_avg_count(0);
                updatePoliceEffect();
            }
            else if (param.effect.no == EFFECT_EMERGENCY)
            {
                set_avg_count(0);
                updateAmbulanceEffect();
            }
            else if (param.effect.no == EFFECT_WELDING)
            {
                set_avg_count(0);
                updateWeldingEffect();
            }
            else if (param.effect.no == EFFECT_CANDLE)
            {
                set_avg_count(3);
                updateCandleEffect();
            }
            else if (param.effect.no == EFFECT_FLICKER)
            {
                set_avg_count(0);
                updateFlickerSparseEffect();
            }
            else if (param.effect.no == EFFECT_TV)
            {
                set_avg_count(0);
                updateTVEffect();
            }
            else if (param.effect.no == EFFECT_PULSE)
            {
                set_avg_count(0);
                updatePulseEffect();
            }
            else if (param.effect.no == EFFECT_LIGHTNING)
            {
                set_avg_count(0);
                updateLightningEffect();
            }
        }

        send_tlc_datas();
    }

    loop_battery_with_top_indicator();

    if ((wifiParam.wireless == WIRELESS_ARTNET) || (wifiParam.wireless == WIRELESS_sACN))
        alite2_ota_loop();

    if ((millis() - last_ms) > 10000)
    {
        set_backlight_bright(LCD_PWM_VALUE >> 4);
    }

    check_artsync_timeout();
    esp_task_wdt_reset();
    //delay(5);
    //dbg.print(".");
}
